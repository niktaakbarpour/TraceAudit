{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceaudit.local/schemas/trace_event_v1_1.schema.json",
  "title": "TraceAudit v1.1 event record projection",
  "description": "An event scoped to its parent episode. episode_id is copied from the enclosing v1.0 trace; source v1.0 records remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "event_id", "event_type", "indices", "timestamps", "measurements", "evidence", "provenance", "quality_flags"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^.+:EVT:[0-9]{4}$"},
    "event_type": {"enum": ["gripper_command_run", "end_effector_motion_segment", "tracked_entity_position_change"]},
    "indices": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_range", "transition_range"],
      "properties": {"frame_range": {"$ref": "#/$defs/indexRange"}, "transition_range": {"$ref": "#/$defs/indexRange"}}
    },
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "start_s", "end_s", "source_values_s_unverified"],
      "properties": {
        "verified": {"const": false},
        "start_s": {"type": "null"},
        "end_s": {"type": "null"},
        "source_values_s_unverified": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number"}
        }
      }
    },
    "measurements": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceReference"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_trace", "time_basis", "classification"],
      "properties": {
        "source_trace": {"type": "string", "minLength": 1},
        "time_basis": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "semantic_note": {"type": ["string", "null"]}
      }
    },
    "quality_flags": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["semantic_uncertainty", "missing_data", "nonfinite_data", "abstention"]}
    }
  },
  "$defs": {
    "indexRange": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2}
      ]
    },
    "evidenceReference": {
      "type": "object", "additionalProperties": false,
      "required": ["hdf5_sha256", "hdf5_path", "transition_index", "mapped_post_action_frame", "frame_index", "mapping_note"],
      "properties": {
        "hdf5_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "hdf5_path": {"type": "string", "minLength": 1},
        "transition_index": {"$ref": "#/$defs/optionalIndex"},
        "mapped_post_action_frame": {"$ref": "#/$defs/optionalIndex"},
        "frame_index": {"$ref": "#/$defs/optionalIndex"},
        "mapping_note": {"type": "string", "minLength": 1}
      }
    },
    "optionalIndex": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
  }
}
